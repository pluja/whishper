{
  "name": "anysub",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm --recursive check",
    "test": "pnpm --recursive test",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore $(test -f .git/info/exclude && echo --ignore-path .git/info/exclude) . && pnpm --recursive format:check"
  },
  "devDependencies": {
    "prettier": "catalog:"
  }
}
