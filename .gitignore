.env
.env.*
!.env.example

# JavaScript
node_modules/
.pnpm-store/
.svelte-kit/
build/
coverage/
playwright-report/
test-results/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Anysub runtime data
data/
models/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Markdown is ignored by default so agent scratch files never reach a commit.
# Every document that ships with the project needs an entry below.
*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!CODE_OF_CONDUCT.md
!docs/**/*.md
!.github/**/*.md
