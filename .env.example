# Optional settings. Anysub runs without a .env file: it generates its secrets
# on first start and keeps them in its database. Models, transcription defaults
# and the upload limit are set in the app under Administration. Copy this file
# to .env and uncomment a line only to change that setting.
# See docs/CONFIGURATION.md.

# Browser-facing application port.
#ANYSUB_PORT=5173

# Port of the development stack (make dev).
#ANYSUB_DEV_PORT=5174

# Anysub answers on any address: localhost, a LAN IP or a hostname. Set this
# only behind an HTTPS reverse proxy, to the address people type, so session
# cookies are marked Secure. Plain-HTTP addresses then cannot sign in.
#BETTER_AUTH_URL=https://subtitles.example.org

# Behind a reverse proxy that sets X-Forwarded-For, uncomment so failed
# sign-ins are throttled per client rather than per proxy.
#ANYSUB_ADDRESS_HEADER=X-Forwarded-For

# Per-request SvelteKit limit. Must remain larger than the 32 MiB tus chunk.
#ANYSUB_BODY_SIZE_LIMIT=64M

# NVIDIA GPU: uncomment so every docker compose command includes the CUDA
# overlay, then run docker compose up --build -d. Needs the NVIDIA Container
# Toolkit and a Volta or newer card. See docs/CONFIGURATION.md#nvidia-gpus.
#COMPOSE_FILE=compose.yaml:compose.cuda.yaml

# Identifies this worker in the model picker when several are connected.
#ANYSUB_WORKER_NAME=local-worker
