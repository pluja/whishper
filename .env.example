# Reference only. Run scripts/init-env.sh to generate a .env with real secrets.
#
# Anysub refuses to start when BETTER_AUTH_SECRET or ANYSUB_WORKER_TOKEN still
# holds one of the placeholders below, because they are published in this
# repository. Anyone who reads them could forge sessions on an exposed
# installation.
POSTGRES_DB=anysub
POSTGRES_USER=anysub
POSTGRES_PASSWORD=change-this-database-password

# Signs session cookies. At least 32 characters. Changing it signs every
# account out.
BETTER_AUTH_SECRET=change-this-to-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173

# Shared only by the application and workers. At least 24 characters. Remote
# workers must use unique enrollment credentials once the enrollment flow is
# implemented.
ANYSUB_WORKER_TOKEN=change-this-worker-token

# Browser-facing application port.
ANYSUB_PORT=5173

# Maximum size of one resumable browser upload (default: 500 GiB).
ANYSUB_MAX_UPLOAD_BYTES=536870912000

# Per-request SvelteKit limit. Must remain larger than the 32 MiB tus chunk.
ANYSUB_BODY_SIZE_LIMIT=64M

# Worker tuning. Leave these commented out unless you need to change them:
# each mode already picks a sensible default, and setting a value here
# overrides the default for every mode. See docs/CONFIGURATION.md.

# Acceleration: cpu or cuda. Changing it rebuilds the worker image with
# matching PyTorch wheels. The NVIDIA overlay sets cuda on its own:
#   docker compose -f compose.yaml -f compose.cuda.yaml up --build
#ANYSUB_ACCELERATOR=cpu

# Model precision. Lower precision runs faster and uses less memory.
# Defaults to int8 on cpu and float16 on cuda.
#   cpu:  int8, int8_float32, float32
#   cuda: float16, int8_float16, float32
#ANYSUB_COMPUTE_TYPE=int8

# Identifies this worker in the model picker when several are connected.
#ANYSUB_WORKER_NAME=local-worker
