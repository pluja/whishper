# Copy to .env before exposing Anysub beyond localhost.
POSTGRES_DB=anysub
POSTGRES_USER=anysub
POSTGRES_PASSWORD=change-this-database-password

# Generate with: docker compose run --rm web node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-this-to-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173

# Shared only by the application and workers. Remote workers must use unique
# enrollment credentials once the enrollment flow is implemented.
ANYSUB_WORKER_TOKEN=change-this-worker-token

# Browser-facing application port.
ANYSUB_PORT=5173

# Maximum size of one resumable browser upload (default: 500 GiB).
ANYSUB_MAX_UPLOAD_BYTES=536870912000
